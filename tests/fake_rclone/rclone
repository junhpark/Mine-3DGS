#!/usr/bin/env python3
"""A stand-in for the rclone subcommands RcloneStore uses, over a local directory.

``<name>:<path>`` resolves to ``$FAKE_RCLONE_ROOT/<path>``. Only transport is emulated; every
integrity check stays in MineGS. Exit codes follow rclone (3: directory not found).
"""
import fnmatch
import json
import os
import shutil
import sys
from pathlib import Path

ROOT = Path(os.environ["FAKE_RCLONE_ROOT"])


def loc(arg):
    if ":" in arg and not arg.startswith("/"):
        return ROOT / arg.split(":", 1)[1]
    return Path(arg)


def main(argv):
    cmd, rest = argv[0], argv[1:]
    opts, pos, files_from, excludes = {}, [], None, []
    it = iter(rest)
    for a in it:
        if a == "--files-from":
            files_from = next(it)
        elif a == "--exclude":
            excludes.append(next(it))
        elif a in ("--transfers",):
            next(it)
        elif a.startswith("--"):
            opts[a] = True
        else:
            pos.append(a)
    if cmd == "lsjson":
        p = loc(pos[0])
        if not p.exists():
            print("directory not found", file=sys.stderr)
            return 3
        print(json.dumps({"Path": p.name, "IsDir": p.is_dir()}))
        return 0
    if cmd == "cat":
        sys.stdout.buffer.write(loc(pos[0]).read_bytes())
        return 0
    if cmd == "copyto":
        dst = loc(pos[1])
        dst.parent.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(loc(pos[0]), dst)
        return 0
    if cmd == "moveto":
        dst = loc(pos[1])
        dst.parent.mkdir(parents=True, exist_ok=True)
        os.replace(loc(pos[0]), dst)
        return 0
    if cmd == "copy":
        src, dst = loc(pos[0]), loc(pos[1])
        if files_from:
            names = [x for x in Path(files_from).read_text().splitlines() if x]
        else:
            names = [p.relative_to(src).as_posix() for p in src.rglob("*") if p.is_file()]
        for n in names:
            if any(fnmatch.fnmatch(n, e) for e in excludes):
                continue
            out = dst / n
            out.parent.mkdir(parents=True, exist_ok=True)
            shutil.copyfile(src / n, out)
        return 0
    print(f"fake rclone: unsupported {cmd}", file=sys.stderr)
    return 1


sys.exit(main(sys.argv[1:]))
